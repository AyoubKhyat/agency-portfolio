# =============================================================================
# Ibda3 Digital — variables d'environnement
# Copier ce fichier en `.env` puis remplir les valeurs. Ne JAMAIS committer `.env`.
# =============================================================================

# --- Base de données (PostgreSQL) -------------------------------------------
# Obligatoire pour l'admin, les leads et le CRM. Sans elle, le site public
# tourne en mode dégradé (projets de secours, pas d'admin).
# L'adaptateur est choisi selon l'hôte : *.neon.tech -> Neon, sinon pg (VPS / Docker).
DATABASE_URL=

# --- Authentification admin --------------------------------------------------
# Chaîne aléatoire de 32+ caractères (ex. : `openssl rand -base64 48`).
JWT_SECRET="remplacer-par-une-chaine-aleatoire-de-32-caracteres-minimum"

# Utilisés uniquement par le seed (`npm run seed`) pour créer le compte admin.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="changer-ce-mot-de-passe"

# --- EmailJS (formulaire de contact, côté client) ---------------------------
# Exposées au navigateur et figées au moment du build : rebuild après modification.
NEXT_PUBLIC_EMAILJS_SERVICE_ID="service_xxxxxxx"
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID="template_xxxxxxx"
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY="xxxxxxxxxxxxxxxxx"

# --- Propriétaire et images --------------------------------------------------
# Id du compte propriétaire (exports, sauvegardes, webhooks).
OWNER_USER_ID=
# Auto-hébergement : dossier persistant des couvertures de projets, servi sur /uploads.
# Sans UPLOAD_DIR, les couvertures vont sur Vercel Blob (BLOB_READ_WRITE_TOKEN) ou public/projects en local.
UPLOAD_DIR=
# UPLOAD_PUBLIC_PATH=/uploads

# --- Prospection ------------------------------------------------------------
# Optionnel : enrichissement via Google Places.
GOOGLE_PLACES_API_KEY=""
# Dev uniquement : "1" = données de prospection fictives au lieu d'OpenStreetMap.
DISCOVERY_USE_MOCK=""

# --- Scripts ponctuels (scripts/*, prisma/*.mjs) — inutiles pour l'app -------
# URL de l'instance cible pour scripts/seed-morocco-prospects*.mjs
# IBDA3_URL="http://localhost:3000"
# DRY_RUN="1"
# APPLY="1"

# --- Vitrine séparée de l'admin (optionnel, voir docs/architecture) ----------
# Clé partagée serveur à serveur (32+ caractères), identique des deux côtés.
# Côté admin : active POST /api/internal/leads. Côté vitrine : avec ADMIN_API_URL, le formulaire
# de contact transmet le lead à l'admin au lieu d'écrire en base.
# INTERNAL_API_KEY=
# ADMIN_API_URL=https://admin.example.com
